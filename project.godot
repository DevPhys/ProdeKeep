; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ProbeKeep"
run/main_scene="uid://daufekjr7qd8t"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="ProbeKeep"

[physics]

2d/run_on_separate_thread=true
2d/physics_engine="GodotPhysics2D"
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
driver/threads/thread_model=0
environment/defaults/default_clear_color=Color(0.1882353, 0.8352941, 0.9254902, 1)
occlusion_culling/use_occlusion_culling=true
